# 文件说明：该文件属于部署模板，集中实现 mmsec eval platform.service 相关逻辑。
[Unit]
Description=mmsec-eval-platform API service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mmsec-eval-platform
EnvironmentFile=/opt/mmsec-eval-platform/.env
ExecStart=/bin/bash /opt/mmsec-eval-platform/scripts/run_backend.sh
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
